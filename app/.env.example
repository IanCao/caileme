# Cloudflare AI Configuration
# Get your Cloudflare Account ID from Cloudflare Dashboard -> Workers & Pages
CLOUDFLARE_ACCOUNT_ID=your_account_id

# Create an AI Gateway in Cloudflare Dashboard -> AI -> AI Gateway
# Then create an API token with Workers AI permissions
# Get your API token from https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_api_token

# Model selection for AI layoff simulation
# Free tier: 10,000 neurons/day (resets at 00:00 UTC)
# 
# Recommended models for Chinese users:
# 
# 1. @cf/qwen/qwen2.5-7b-instruct (RECOMMENDED)
#    - Excellent Chinese language support
#    - 7B parameters, good balance of quality and speed
#    - Neuron consumption: ~2,457/M input tokens, ~18,252/M output tokens
#
# 2. @cf/meta/llama-3.2-3b-instruct
#    - Efficient, lower neuron consumption
#    - Good multilingual support
#    - Better for simple role-play scenarios
#
# 3. @cf/deepseek-ai/deepseek-v3-aggregated
#    - Strong reasoning capabilities
#    - Good for complex negotiation scenarios
#
# 4. @cf/meta/llama-3.1-8b-instruct
#    - Larger model, better quality
#    - Higher neuron consumption
#    - Good if you have more daily quota

CLOUDFLARE_AI_MODEL=@cf/qwen/qwen2.5-7b-instruct
